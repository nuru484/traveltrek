NEXT_PUBLIC_SERVER_URI=<backend api url>
NEXT_PUBLIC_BASE_URL=<frontend url>

# Demo login is server-side (POST /auth/demo-login) — no demo credentials or
# emails ship in the client. Configure the demo accounts on the BACKEND
# (DEMO_LOGIN_ENABLED + DEMO_ADMIN_EMAIL / DEMO_AGENT_EMAIL / DEMO_CUSTOMER_EMAIL).

NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your_google_oauth_client_id>

# Error tracking (Sentry). Leave the DSN unset locally: the SDK stays inert.
NEXT_PUBLIC_SENTRY_DSN=<sentry project dsn>
NEXT_PUBLIC_SENTRY_ENVIRONMENT=<production | preview | development>
# Release tag on events. Optional: Vercel's VERCEL_GIT_COMMIT_SHA is used
# when this is unset, so it never needs setting there.
# SENTRY_RELEASE=<git sha>

# CI-only: upload source maps at build time. Unset means no upload, never a failed build.
SENTRY_ORG=<sentry org slug>
SENTRY_PROJECT=<sentry project slug>
SENTRY_AUTH_TOKEN=<sentry auth token with project:releases scope>
