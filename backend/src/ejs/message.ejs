<%- include('partials/header') %>

<% (typeof intro !== 'undefined' ? intro : []).forEach(function (paragraph) { %>
  <p style="margin: 0 0 14px 0; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: <%= brand.ink %>;"><%= paragraph %></p>
<% }); %>

<% if (typeof code !== 'undefined' && code) { %>
  <!-- One-time code: night plate, digits stamped in sky blue. -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 20px 0 10px 0; border-collapse: collapse;">
    <tr>
      <td align="center" style="background: <%= brand.night %>; border-radius: 10px; padding: 22px 12px;">
        <span style="font-family: Helvetica, Arial, sans-serif; font-size: 26px; font-weight: 700; letter-spacing: 8px; color: <%= brand.sky %>;"><%= code %></span>
      </td>
    </tr>
  </table>
  <% if (typeof codeNote !== 'undefined' && codeNote) { %>
    <p style="margin: 0 0 14px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12.5px; line-height: 1.6; color: <%= brand.muted %>;"><%= codeNote %></p>
  <% } %>
<% } %>

<% if (typeof amount !== 'undefined' && amount) { %>
  <!-- Headline figure: the money the message is about. -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 0 0 18px 0; border-collapse: collapse;">
    <tr>
      <td style="background: <%= brand.night %>; border-left: 6px solid <%= brand.primary %>; border-radius: 10px; padding: 18px 20px;">
        <p style="margin: 0 0 6px 0; font-family: Helvetica, Arial, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: <%= brand.sky %>;"><%= amount.label %></p>
        <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 700; line-height: 1.2; color: <%= brand.paper %>;"><%= amount.value %></p>
        <% if (amount.note) { %>
          <p style="margin: 10px 0 0 0; font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.5; color: <%= brand.mutedOnDark %>;"><%= amount.note %></p>
        <% } %>
      </td>
    </tr>
  </table>
<% } %>

<% if (typeof rows !== 'undefined' && rows && rows.length) { %>
  <!-- Ruled key/value block. Label and value share a line on a desktop card;
       under 600px the media query in the head turns both cells into blocks so
       the value sits under its label instead of being squeezed beside it. -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 0 0 18px 0; border: 1px dashed <%= brand.rule %>; border-collapse: collapse; border-radius: 10px; background: <%= brand.surfaceAlt %>;">
    <% if (typeof rowsCaption !== 'undefined' && rowsCaption) { %>
      <tr>
        <td colspan="2" style="background: <%= brand.night %>; padding: 10px 16px; font-family: Helvetica, Arial, sans-serif; font-family: 'Courier New', Courier, monospace; font-size: 10.5px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: <%= brand.paper %>;"><%= rowsCaption %></td>
      </tr>
    <% } %>
    <% rows.forEach(function (row, index) { %>
      <tr>
        <td class="detail-label" style="padding: 10px 8px 10px 16px; border-bottom: <%= index === rows.length - 1 ? 'none' : '1px dashed ' + brand.rule %>; font-family: Helvetica, Arial, sans-serif; font-family: 'Courier New', Courier, monospace; font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.5; color: <%= brand.muted %>; white-space: nowrap;"><%= row.label %></td>
        <td class="detail-value" align="right" style="padding: 10px 16px 10px 8px; border-bottom: <%= index === rows.length - 1 ? 'none' : '1px dashed ' + brand.rule %>; font-family: Helvetica, Arial, sans-serif; font-size: 13.5px; font-weight: 700; line-height: 1.5; text-align: right; color: <%= brand.ink %>; word-break: break-word;"><%= row.value %></td>
      </tr>
    <% }); %>
  </table>
<% } %>

<% if (typeof action !== 'undefined' && action) { %>
  <!-- Built as a table cell rather than a padded <a> so Outlook keeps the padding. -->
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 20px 0 12px 0; border-collapse: separate;">
    <tr>
      <td style="background: <%= brand.primary %>; border-radius: 10px;">
        <a href="<%= action.url %>" style="display: inline-block; padding: 14px 28px; font-family: Helvetica, Arial, sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #ffffff; text-decoration: none;"><%= action.label %></a>
      </td>
    </tr>
  </table>
  <p style="margin: 0 0 14px 0; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.6; color: <%= brand.muted %>;">Or paste this link: <span style="color: <%= brand.primaryDeep %>; word-break: break-all;"><%= action.url %></span></p>
<% } %>

<% if (typeof note !== 'undefined' && note) { %>
  <p style="margin: 18px 0 0 0; font-family: Helvetica, Arial, sans-serif; font-size: 12.5px; line-height: 1.6; color: <%= brand.muted %>;"><%= note %></p>
<% } %>

<%- include('partials/footer') %>
