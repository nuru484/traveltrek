{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend code for Travel Trek",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#types/*": "./types/*",
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "tsx --watch --env-file .env server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "clean": "rm -rf build",
    "build": "npm run clean && npx tsc -p tsconfig.build.json --diagnostics && npx tsc-alias -p tsconfig.build.json && echo 'Build completed successfully!'",
    "start": "node build/server.js",
    "start:dev": "node --env-file .env build/server.js",
    "type-check": "tsc --noEmit",
    "migrate": "node --env-file .env ./node_modules/.bin/prisma migrate dev",
    "seed": "npx prisma db seed",
    "deploy": "npm install --include=dev && npx prisma generate && npm run build",
    "worker": "node build/worker.js",
    "worker:dev": "tsx --watch --env-file .env worker.ts",
    "postinstall": "npx prisma generate",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:deploy:local": "node --env-file .env ./node_modules/.bin/prisma migrate deploy",
    "studio": "node --env-file .env ./node_modules/.bin/prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "travel",
    "tour"
  ],
  "author": "Abdul-Majeed Nurudeen",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.31.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.53.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.66.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.62.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "p-map": "^7.0.3",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "prisma": "7.8.0",
    "rate-limit-redis": "^6.0.0",
    "zod": "^4.4.3"
  }
}
