// schema.prisma

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Staff roles only. Customers have no role — they live in the separate
/// Customer model; the app-level UserRole type still uses 'CUSTOMER' as the
/// role customers present on their access tokens, but no User row carries it.
enum Role {
  ADMIN
  AGENT
}

/// STAFF ONLY: every row is an ADMIN or AGENT operating the system.
/// Customers live in the separate Customer model below.
model User {
  id   Int    @id @default(autoincrement())
  name String

  /// Nullable: phone-only signups have no email. Postgres allows multiple
  /// NULLs under a unique index, so the constraint still holds where it matters.
  email String? @unique

  /// Nullable: minimal signups and Google-created accounts have no password —
  /// they authenticate via OTP login or Google until they set one.
  password       String?
  /// Defaults to the least-privileged staff role; ADMIN is always explicit.
  role           Role     @default(AGENT)
  phone          String?  @unique
  address        String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Google account subject (`sub` claim) once the user signs in with Google;
  /// set at creation or linked to an existing verified-email account.
  googleId String? @unique

  /// Session epoch: every issued token embeds it, and a mismatch on
  /// verification rejects the token. Bumping it invalidates every live
  /// session at once (refresh-token theft response).
  tokenVersion Int @default(0)

  /// Consecutive wrong-password counter; at the threshold the account is
  /// temporarily locked (lockedUntil), then the counter starts fresh.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// When true, a correct password alone does not establish a session: login
  /// answers with twoFactorRequired and a TWO_FACTOR code must be verified
  /// first. OTP login and Google sign-in (customer-only surfaces) are already
  /// single-possession-factor and bypass this flag by design.
  twoFactorEnabled Boolean @default(false)

  /// Soft delete: reads are auto-scoped to `deletedAt: null` by the client
  /// extension (src/lib/soft-delete-extension.ts).
  deletedAt DateTime?

  /// Self-service email change in flight: the requested address, applied to
  /// `email` only when the confirmation link (EMAIL_CHANGE token, sent to the
  /// NEW address) is redeemed. Cleared on apply or on a conflict at confirm.
  pendingEmail String?
  /// Self-service phone change in flight: applied to `phone` only when the
  /// OTP (PHONE_CHANGE, texted to the NEW number) is verified.
  pendingPhone String?

  securityTokens  UserSecurityToken[]
  /// Bookings this staff member created on behalf of customers (attribution).
  createdBookings Booking[]           @relation("BookingCreatedBy")

  @@index([deletedAt])
}

/// The customer principal, kept separate from User so the business can manage
/// customer profiles (full booking/payment history, contact details)
/// independently of staff accounts. Same auth surface as staff — optional
/// password (OTP/Google otherwise), lockout counters, tokenVersion session
/// epoch — but no role: a customer is always exactly a customer.
model Customer {
  id   Int    @id @default(autoincrement())
  name String

  /// Nullable: phone-only signups have no email. Postgres allows multiple
  /// NULLs under a unique index, so the constraint still holds where it matters.
  email String? @unique

  /// Nullable: minimal signups and Google-created accounts have no password —
  /// they authenticate via OTP login or Google until they set one.
  password       String?
  phone          String?  @unique
  address        String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Google account subject (`sub` claim) once the customer signs in with
  /// Google; set at creation or linked to an existing verified-email account.
  googleId String? @unique

  /// Session epoch: every issued token embeds it, and a mismatch on
  /// verification rejects the token. Bumping it invalidates every live
  /// session at once (refresh-token theft response).
  tokenVersion Int @default(0)

  /// Consecutive wrong-password counter; at the threshold the account is
  /// temporarily locked (lockedUntil), then the counter starts fresh.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// When true, a correct password alone does not establish a session: login
  /// answers with twoFactorRequired and a TWO_FACTOR code must be verified
  /// first. OTP login and Google sign-in are already single-possession-factor
  /// and bypass this flag by design.
  twoFactorEnabled Boolean @default(false)

  /// Soft delete: reads are auto-scoped to `deletedAt: null` by the client
  /// extension (src/lib/soft-delete-extension.ts).
  deletedAt DateTime?

  /// Self-service email change in flight: the requested address, applied to
  /// `email` only when the confirmation link (EMAIL_CHANGE token, sent to the
  /// NEW address) is redeemed. Cleared on apply or on a conflict at confirm.
  pendingEmail String?
  /// Self-service phone change in flight: applied to `phone` only when the
  /// OTP (PHONE_CHANGE, texted to the NEW number) is verified.
  pendingPhone String?

  bookings       Booking[]
  payments       Payment[]
  reviews        Review[]
  securityTokens UserSecurityToken[]

  @@index([deletedAt])
}

enum TokenType {
  /// The jti of an issued refresh JWT. Consumed when that token is exchanged
  /// (rotation); presenting an already-consumed jti outside the concurrency
  /// grace window is treated as theft and bumps the session epoch.
  REFRESH
  /// 6-digit email OTP for passwordless login.
  OTP_LOGIN
  /// Long random opaque token embedded in a password-reset link.
  PASSWORD_RESET
  /// 6-digit second-factor code: sent on password login when the principal has
  /// twoFactorEnabled, and by the authed /auth/2fa/challenge step that gates
  /// enabling/disabling the feature. Single-use, attempt-capped (attempts col).
  /// Also consumed as the re-auth proof for passwordless accounts changing
  /// their email/phone (issued by POST /auth/reauth/challenge).
  TWO_FACTOR
  /// Long random opaque token in the confirmation link emailed to the NEW
  /// address of a pending email change; redeeming it applies pendingEmail.
  EMAIL_CHANGE
  /// 6-digit OTP texted to the NEW phone of a pending phone change; redeeming
  /// it (authenticated) applies pendingPhone. Attempt-capped like OTP_LOGIN.
  PHONE_CHANGE
}

/// One security-token row belongs to exactly ONE principal: either a staff
/// user (userId) or a customer (customerId) — enforced by a DB CHECK
/// constraint (num_nonnulls = 1, see the separate_customers_from_staff
/// migration) and by the auth service, which always sets exactly one FK.
model UserSecurityToken {
  id         String    @id @default(uuid())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId Int?

  /// sha256 hex of the plaintext token/jti — the plaintext is never persisted.
  tokenHash String    @unique
  type      TokenType

  expiresAt  DateTime
  consumedAt DateTime?

  /// Wrong-guess counter for OTP codes; at the cap the token is dead and a
  /// fresh code must be requested. Unused (0) for REFRESH/PASSWORD_RESET rows.
  attempts Int @default(0)

  /// Rotation audit trail: when a refresh token is exchanged, the hash of the
  /// successor's jti is recorded on the consumed row.
  replacedByTokenHash String?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([customerId, type])
  @@index([expiresAt])
}

enum TourType {
  ADVENTURE
  CULTURAL
  BEACH
  CITY
  WILDLIFE
  CRUISE
}

enum TourStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Tour {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  photo        String?
  type         TourType
  status       TourStatus @default(UPCOMING)
  duration     Int
  /// Integer minor units (pesewas): GH₵ 1.00 = 100.
  price        Int
  maxGuests    Int
  guestsBooked Int        @default(0)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  bookings      Booking[]
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  destinationId Int

  @@index([deletedAt])
  @@index([name], name: "tour_name_idx")
  @@index([startDate, endDate], name: "tour_start_end_idx")
  @@index([type, status], name: "tour_type_status_idx")
  @@index([guestsBooked], name: "tour_guest_booked_idx")
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  country     String
  city        String?
  photo       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tours              Tour[]
  hotels             Hotel[]
  originFlights      Flight[] @relation("FlightOrigin")
  destinationFlights Flight[] @relation("FlightDestination")

  @@index([deletedAt])
  @@index([name], name: "destination_name_idx")
  @@index([country, city], name: "destination_country_city_idx")
}

model Hotel {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  address       String
  phone         String?
  photo         String?
  starRating    Int         @default(3)
  amenities     String[]
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  destinationId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  rooms Room[]

  @@index([deletedAt])
  @@index([name], name: "hotel_name_idx")
  @@index([destinationId], name: "hotel_destination_idx")
  @@index([starRating], name: "hotel_star_rating_idx")
  @@index([address], name: "hotel_address_idx")
}

model Room {
  id            Int      @id @default(autoincrement())
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId       Int
  roomType      String
  /// Integer minor units (pesewas): GH₵ 1.00 = 100.
  pricePerNight Int
  capacity      Int
  totalRooms    Int
  photo         String?
  description   String?
  amenities     String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  bookings Booking[]

  @@index([deletedAt])
  @@index([hotelId, roomType], name: "room_hotel_type_idx")
  @@index([pricePerNight], name: "room_price_idx")
  @@index([capacity], name: "room_capacity_idx")
}

enum FlightStatus {
  SCHEDULED
  DEPARTED
  LANDED
  CANCELLED
  DELAYED
}

model Flight {
  id             Int          @id @default(autoincrement())
  flightNumber   String       @unique
  airline        String
  departure      DateTime
  arrival        DateTime
  origin         Destination  @relation("FlightOrigin", fields: [originId], references: [id], onDelete: Restrict)
  originId       Int
  destination    Destination  @relation("FlightDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  destinationId  Int
  /// Integer minor units (pesewas): GH₵ 1.00 = 100.
  price          Int
  photo          String?
  flightClass    String
  status         FlightStatus @default(SCHEDULED)
  duration       Int
  stops          Int          @default(0)
  capacity       Int
  seatsAvailable Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  bookings Booking[]

  @@index([deletedAt])
  @@index([originId, destinationId])
  @@index([departure, arrival])
  @@index([status])
  @@index([seatsAvailable])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId Int

  tour   Tour? @relation(fields: [tourId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tourId Int?

  room   Room? @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roomId Int?

  flight   Flight? @relation(fields: [flightId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  flightId Int?

  /// Staff attribution: the ADMIN/AGENT who created this booking on behalf of
  /// the customer; null for customer self-bookings. Restrict is safe because
  /// staff deletes are soft (deletedAt) — the FK never actually blocks.
  createdBy       User? @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUserId Int?

  status BookingStatus @default(PENDING)

  numberOfGuests  Int     @default(1)
  specialRequests String?

  startDate      DateTime? // Check-in date for rooms
  endDate        DateTime? // Check-out date for rooms
  numberOfRooms  Int       @default(1) // How many rooms booked
  numberOfNights Int       @default(1) // Auto-calculated nights

  paymentDeadline          DateTime? // When payment must be completed
  requiresImmediatePayment Boolean   @default(false) // Flag for same-day bookings

  /// Integer minor units (pesewas): GH₵ 1.00 = 100.
  totalPrice  Int
  bookingDate DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  payment Payment?
  review  Review?

  @@unique([customerId, tourId])
  @@unique([customerId, roomId, startDate, endDate])
  @@unique([customerId, flightId])
  @@index([createdByUserId])
  @@index([deletedAt])
  @@index([customerId, tourId, roomId, flightId], name: "booking_customer_tour_hotel_room_flight_idx")
  @@index([status])
  @@index([paymentDeadline])
  @@index([startDate, endDate])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  /// A customer self-cancelled a CONFIRMED booking whose payment had already
  /// COMPLETED: the money is held pending an admin actioning the refund via
  /// PATCH /payments/:id/refund (REFUND_REQUESTED → REFUNDED).
  REFUND_REQUESTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

/// A customer's review of ONE completed booking (bookingId is unique). The
/// review's target (tour / room / flight) is derived from the booking's
/// relations — no separate target columns. Moderation is a status flip
/// (PUBLISHED ↔ HIDDEN); only PUBLISHED, non-deleted rows feed the public
/// surface and the rating aggregates.
model Review {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId Int
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingId  Int      @unique

  /// 1–5 stars, validated at the boundary and in the service.
  rating  Int
  title   String? @db.VarChar(120)
  comment String? @db.VarChar(2000)

  status ReviewStatus @default(PUBLISHED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([status, deletedAt])
  @@index([deletedAt])
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

model Payment {
  id                   Int           @id @default(autoincrement())
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingId            Int           @unique
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId           Int
  /// Integer minor units (pesewas): GH₵ 1.00 = 100.
  amount               Int
  currency             String        @default("GHS")
  status               PaymentStatus @default(PENDING)
  paymentDate          DateTime?
  paymentMethod        PaymentMethod
  transactionReference String?       @unique
  /// Set when the payment moves to REFUNDED: the moment the ledger claimed the
  /// reversal, which is before the Paystack refund call. The reconciliation
  /// sweep uses it to find claims the provider never received.
  refundedAt           DateTime?
  refundReason         String?
  /// Paystack's id for the refund it holds against this charge, when the
  /// refund was issued (or discovered) through the API.
  providerRefundId     Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  @@index([deletedAt])
  @@index([status, refundedAt])
  @@index([customerId], name: "payment_customer_idx")
  @@index([transactionReference], name: "payment_transaction_ref_idx")
  @@index([status])
}
