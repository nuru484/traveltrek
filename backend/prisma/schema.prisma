// schema.prisma

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
  AGENT
}

model User {
  id   Int    @id @default(autoincrement())
  name String

  /// Nullable: phone-only signups have no email. Postgres allows multiple
  /// NULLs under a unique index, so the constraint still holds where it matters.
  email String? @unique

  /// Nullable: minimal signups and Google-created accounts have no password —
  /// they authenticate via OTP login or Google until they set one.
  password       String?
  role           Role     @default(CUSTOMER)
  phone          String?  @unique
  address        String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Google account subject (`sub` claim) once the user signs in with Google;
  /// set at creation or linked to an existing verified-email account.
  googleId String? @unique

  /// Session epoch: every issued token embeds it, and a mismatch on
  /// verification rejects the token. Bumping it invalidates every live
  /// session at once (refresh-token theft response).
  tokenVersion Int @default(0)

  /// Consecutive wrong-password counter; at the threshold the account is
  /// temporarily locked (lockedUntil), then the counter starts fresh.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  bookings       Booking[]
  payments       Payment[]
  securityTokens UserSecurityToken[]
}

enum TokenType {
  /// The jti of an issued refresh JWT. Consumed when that token is exchanged
  /// (rotation); presenting an already-consumed jti outside the concurrency
  /// grace window is treated as theft and bumps the session epoch.
  REFRESH
  /// 6-digit email OTP for passwordless login (next phase).
  OTP_LOGIN
  /// Long random opaque token embedded in a password-reset link (next phase).
  PASSWORD_RESET
}

model UserSecurityToken {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  /// sha256 hex of the plaintext token/jti — the plaintext is never persisted.
  tokenHash String    @unique
  type      TokenType

  expiresAt  DateTime
  consumedAt DateTime?

  /// Wrong-guess counter for OTP codes; at the cap the token is dead and a
  /// fresh code must be requested. Unused (0) for REFRESH/PASSWORD_RESET rows.
  attempts Int @default(0)

  /// Rotation audit trail: when a refresh token is exchanged, the hash of the
  /// successor's jti is recorded on the consumed row.
  replacedByTokenHash String?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

enum TourType {
  ADVENTURE
  CULTURAL
  BEACH
  CITY
  WILDLIFE
  CRUISE
}

enum TourStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Tour {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  type         TourType
  status       TourStatus @default(UPCOMING)
  duration     Int
  price        Float
  maxGuests    Int
  guestsBooked Int        @default(0)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bookings      Booking[]
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  destinationId Int

  @@index([name], name: "tour_name_idx")
  @@index([startDate, endDate], name: "tour_start_end_idx")
  @@index([type, status], name: "tour_type_status_idx")
  @@index([guestsBooked], name: "tour_guest_booked_idx")
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  country     String
  city        String?
  photo       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tours              Tour[]
  hotels             Hotel[]
  originFlights      Flight[] @relation("FlightOrigin")
  destinationFlights Flight[] @relation("FlightDestination")

  @@index([name], name: "destination_name_idx")
  @@index([country, city], name: "destination_country_city_idx")
}

model Hotel {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  address       String
  phone         String?
  photo         String?
  starRating    Int         @default(3)
  amenities     String[]
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  destinationId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  rooms Room[]

  @@index([name], name: "hotel_name_idx")
  @@index([destinationId], name: "hotel_destination_idx")
  @@index([starRating], name: "hotel_star_rating_idx")
  @@index([address], name: "hotel_address_idx")
}

model Room {
  id            Int      @id @default(autoincrement())
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hotelId       Int
  roomType      String
  pricePerNight Float
  capacity      Int
  totalRooms    Int
  photo         String?
  description   String?
  amenities     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]

  @@index([hotelId, roomType], name: "room_hotel_type_idx")
  @@index([pricePerNight], name: "room_price_idx")
  @@index([capacity], name: "room_capacity_idx")
}

enum FlightStatus {
  SCHEDULED
  DEPARTED
  LANDED
  CANCELLED
  DELAYED
}

model Flight {
  id             Int          @id @default(autoincrement())
  flightNumber   String       @unique
  airline        String
  departure      DateTime
  arrival        DateTime
  origin         Destination  @relation("FlightOrigin", fields: [originId], references: [id], onDelete: Cascade)
  originId       Int
  destination    Destination  @relation("FlightDestination", fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId  Int
  price          Float
  photo          String?
  flightClass    String
  status         FlightStatus @default(SCHEDULED)
  duration       Int
  stops          Int          @default(0)
  capacity       Int
  seatsAvailable Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookings Booking[]

  @@index([originId, destinationId])
  @@index([departure, arrival])
  @@index([status])
  @@index([seatsAvailable])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int

  tour   Tour? @relation(fields: [tourId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tourId Int?

  room   Room? @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roomId Int?

  flight   Flight? @relation(fields: [flightId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  flightId Int?

  status BookingStatus @default(PENDING)

  numberOfGuests  Int     @default(1)
  specialRequests String?

  startDate      DateTime? // Check-in date for rooms
  endDate        DateTime? // Check-out date for rooms
  numberOfRooms  Int       @default(1) // How many rooms booked
  numberOfNights Int       @default(1) // Auto-calculated nights

  paymentDeadline          DateTime? // When payment must be completed
  requiresImmediatePayment Boolean   @default(false) // Flag for same-day bookings

  totalPrice  Float
  bookingDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payment Payment?

  @@unique([userId, tourId])
  @@unique([userId, roomId, startDate, endDate])
  @@unique([userId, flightId])
  @@index([userId, tourId, roomId, flightId], name: "booking_user_tour_hotel_room_flight_idx")
  @@index([status])
  @@index([paymentDeadline])
  @@index([startDate, endDate])
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

model Payment {
  id                   Int           @id @default(autoincrement())
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bookingId            Int           @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId               Int
  amount               Float
  currency             String        @default("GHS")
  status               PaymentStatus @default(PENDING)
  paymentDate          DateTime?
  paymentMethod        PaymentMethod
  transactionReference String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId], name: "payment_user_idx")
  @@index([transactionReference], name: "payment_transaction_ref_idx")
  @@index([status])
}
