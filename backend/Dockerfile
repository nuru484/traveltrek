# syntax=docker/dockerfile:1

# ── Stage 1: build ────────────────────────────────────────────────────────────
# Installs all deps, generates the Prisma client, and compiles TS → build/.
# (The generated client is TypeScript — provider "prisma-client" — so it is
# compiled INTO build/generated alongside the app; no separate runtime copy.)
FROM node:22-slim AS builder

WORKDIR /app

# System deps for Prisma / native modules (bcrypt is prebuilt, but keep openssl).
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
# Full install (incl. dev) — needed to compile. `--ignore-scripts` skips the
# postinstall `prisma generate`; we run it explicitly once the schema is copied.
RUN npm ci --ignore-scripts

COPY prisma.config.ts tsconfig.json tsconfig.build.json ./
COPY prisma ./prisma
COPY types ./types
COPY src ./src
COPY app.ts server.ts worker.ts ./

RUN npx prisma generate
RUN npm run build

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
# Lean image with prod deps only (which include the prisma CLI + dotenv, so the
# entrypoint can `migrate deploy`). Carries the compiled build/ and the schema/
# config for migrations at startup. Runs as a non-root user.
FROM node:22-slim AS runner

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
# Prod deps only; skip scripts (the client is already generated and compiled
# into build/generated by the builder).
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Compiled app (build/ contains server.js, worker.js, src/ and the compiled
# generated Prisma client) + schema/config for migrations at startup.
COPY --from=builder /app/build ./build
COPY --from=builder /app/prisma ./prisma
COPY prisma.config.ts ./
COPY docker-entrypoint.sh ./

RUN chmod +x docker-entrypoint.sh && chown -R node:node /app
USER node

# The PaaS injects PORT at runtime; the app reads ENV.PORT (default 3000).
EXPOSE 3000

# Liveness probe (the platform can also be pointed at /health directly).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["./docker-entrypoint.sh"]
