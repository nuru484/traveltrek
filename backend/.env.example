# ===========================
# SERVER CONFIGURATION
# ===========================
PORT=4000
NODE_ENV=development

# ===========================
# DATABASE CONFIGURATION
# ===========================
DATABASE_URL=postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
# Postgres pool cap for the app's pg adapter (optional, default 20)
DB_POOL_MAX=20

# ===========================
# REDIS (BullMQ background jobs)
# ===========================
# e.g. redis://localhost:6379 (use rediss:// for TLS)
REDIS_URL=<your_redis_url>

# ===========================
# BACKGROUND WORKERS
# ===========================
# By default the BullMQ workers run IN-PROCESS with the web server (saves a
# dyno). To run them in a dedicated process instead:
#   1. start that process with `npm run worker` (build/worker.js), and
#   2. set WEB_DISABLE_WORKERS=true on the WEB process only,
# so the same jobs are never processed twice. Optional, default false.
# WEB_DISABLE_WORKERS=true

# Outbound email/SMS go through the durable BullMQ notification queue
# (3 attempts, exponential backoff). Set to true to send directly instead
# (fire-and-forget, no retries) — for tests and Redis-less local runs only.
# Optional, default false.
# NOTIFICATIONS_INLINE=true

# ===========================
# CORS CONFIGURATION
# ===========================
# Comma-separated list of allowed browser origins
CORS_ACCESS=http://localhost:3000

# ===========================
# RATE LIMITING
# ===========================
# Optional shared secret: requests carrying it in the X-Rate-Limit-Bypass
# header skip the IP rate limiter (used by Playwright/integration tooling).
# Unset means no bypass exists (fails closed).
# RATE_LIMIT_BYPASS_SECRET=<random_secret>

# ===========================
# CLOUDINARY CONFIGURATION
# ===========================
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>

# ===========================
# JWT / AUTH TOKENS
# ===========================
ACCESS_TOKEN_SECRET=<your_access_token_secret>
ACCESS_TOKEN_EXPIRY=30m

REFRESH_TOKEN_SECRET=<your_refresh_token_secret>
REFRESH_TOKEN_EXPIRY=7d

COOKIE_DOMAIN=localhost

# ===========================
# PAYMENT CONFIGURATION (PAYSTACK)
# ===========================
PAYSTACK_SECRET_KEY=<your_paystack_secret_key>
PAYSTACK_CALLBACK_URL=http://localhost:3000/dashboard/payments/callback
# Optional override for tests/sandboxes (default https://api.paystack.co)
# PAYSTACK_API_BASE_URL=https://api.paystack.co

# ===========================
# ADMIN ACCOUNT SETUP
# ===========================
# Read ONLY by the admin seed (`npm run seed`), which is NOT part of
# `npm run deploy` — the API/worker boot fine without any of these, so
# production env stores don't need them. The seed is double-gated:
#   ADMIN_SEED_ENABLED=true       or the seed is a logged no-op
#   ADMIN_SEED_FORCE_UPDATE=true  to also overwrite an EXISTING admin with
#                                 the values below (credential rotation);
#                                 without it the seed is create-only.
# Flip them back to false (or remove them) after the run.
ADMIN_EMAIL=<admin_email>
ADMIN_PASSWORD=<admin_password>
ADMIN_NAME=<admin_full_name>
ADMIN_PHONE=<admin_phone_number>
# ADMIN_SEED_ENABLED=true
# ADMIN_SEED_FORCE_UPDATE=true

# ===========================
# DEMO LOGIN (server-side, credential-free)
# ===========================
# Powers POST /auth/demo-login, which mints a real session for a canned
# ADMIN / AGENT / CUSTOMER account WITHOUT sending any credentials to the
# browser. Disabled by default (the endpoint 403s). When enabled, each role
# resolves a REAL account by its email: ADMIN/AGENT are staff Users,
# DEMO_CUSTOMER_EMAIL is a Customer — seed these accounts first (an unset or
# unseeded email makes that role's demo login 404). Never NEXT_PUBLIC_*.
# DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_EMAIL=<demo admin email>
DEMO_AGENT_EMAIL=<demo agent email>
DEMO_CUSTOMER_EMAIL=<demo customer email>

# ===========================
# FRONTEND (links in emails)
# ===========================
FRONTEND_URL=http://localhost:3000

# ===========================
# SMTP (optional — unset logs emails instead of sending)
# ===========================
SMTP_HOST=<your_smtp_host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your_smtp_username>
SMTP_PASSWORD=<your_smtp_password>
MAIL_FROM_NAME=TravelTrek
MAIL_FROM_EMAIL=no-reply@traveltrek.local

# ===========================
# FROG SMS (optional — unset logs SMS instead of sending)
# ===========================
FROG_API_KEY=<your_frog_api_key>
FROG_USERNAME=<your_frog_username>
FROG_SENDER_ID=<your_frog_sender_id>

# ===========================
# GOOGLE SIGN-IN (optional — unset disables POST /auth/google with a 503)
# ===========================
GOOGLE_CLIENT_ID=<your_google_oauth_client_id>

# ===========================
# SENTRY ERROR TRACKING (optional — unset disables reporting entirely)
# ===========================
# Only unexpected errors (5xx / HIGH-CRITICAL severity) are reported.
# SENTRY_DSN=<your_sentry_dsn>
# Environment tag on events (defaults to NODE_ENV)
# SENTRY_ENVIRONMENT=production
# Performance-tracing sample rate 0-1 (default 0 = errors only)
# SENTRY_TRACES_SAMPLE_RATE=0
